# PostgreSQL Database Configuration
POSTGRES_DATABASE=limon_db
POSTGRES_USER=limon_user
POSTGRES_PASSWORD=limon_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MySQL (for migration only)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=facturador

# Backend Configuration
SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DEBUG=True

# CORS Configuration
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Hasar Fiscal Printer Configuration
HASAR_LEGACY_PATH=/var/www/fiscal
HASAR_2_HOST=192.168.1.100
HASAR_2_PORT=80
HASAR_2_PASSWORD=fiscal_password

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# PgAdmin Configuration
PGADMIN_EMAIL=admin@limon.com
PGADMIN_PASSWORD=admin
